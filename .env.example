# Required provider credentials. Keep real values in local .env or Streamlit Cloud Secrets only.
GROQ_API_KEY=replace_with_your_groq_api_key
OLLAMA_API_KEY=replace_with_your_ollama_cloud_api_key
# Optional last-resort backup; used only after both Groq and Ollama fail.
GEMINI_API_KEY=

# Required access control for the deployed app. Replace with a long random password.
PROMPTLAB_ACCESS_PASSWORD=replace_with_a_long_random_password

# Backend model defaults (not selectable from the app UI).
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=gpt-oss:20b-cloud
GEMINI_MODEL=gemini-3.8-flash
GROQ_TEST_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=https://ollama.com/v1

# Security defaults: host-local code execution is off; actual execution requires a Docker opt-in.
PROMPTLAB_ENABLE_DOCKER_EXECUTION=false
PROMPTLAB_MAX_RUNS_PER_HOUR=6

# For a local Ollama server only, use these instead of the cloud endpoint/key:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
