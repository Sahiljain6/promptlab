# Copy this file to .env and add your own API key.
PROMPTLAB_PROVIDER=Groq
GROQ_API_KEY=replace_with_your_groq_api_key
# Default Groq model: openai/gpt-oss-20b

# For OpenAI, set PROMPTLAB_PROVIDER=OpenAI and configure:
# OPENAI_API_KEY=replace_with_your_openai_api_key

# For a different OpenAI-compatible service:
# PROMPTLAB_PROVIDER=Custom OpenAI-compatible
# PROMPTLAB_API_KEY=replace_with_your_api_key
# PROMPTLAB_BASE_URL=https://your-provider.example/v1
# PROMPTLAB_MODEL=your-active-model-id

# For cloud AI-based test review using Groq (predicts outcomes; does not execute Python):
# Reuses GROQ_API_KEY above; no second API key is needed.
GROQ_TEST_MODEL=openai/gpt-oss-20b
